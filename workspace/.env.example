# Cloudflare Pages environment variables for the workspace.
#
# Set these in the Pages project (Settings -> Environment variables), NOT in a
# committed file. GITHUB_CLIENT_SECRET and SESSION_SECRET must be marked as
# ENCRYPTED / secret, not plain text.
#
# Note the contrast with the marketing site, where every variable is PUBLIC_ by
# design because the values are public identifiers. Here two of them are genuine
# secrets and must never reach the browser.

# From the GitHub OAuth App (org Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=        # SECRET

# openssl rand -base64 48
SESSION_SECRET=              # SECRET

# The org whose membership grants access, and which owns the team repositories
GITHUB_ORG=Innovation-forum-Cambridgeshire
